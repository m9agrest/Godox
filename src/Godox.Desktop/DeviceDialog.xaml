<Window x:Class="Godox.Desktop.DeviceDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Style="{StaticResource {x:Type Window}}" Title="Настройка светильника" Width="620" Height="700" MinHeight="600" WindowStartupLocation="CenterOwner">
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="28">
  <TextBlock Text="Профиль светильника" FontSize="25" FontWeight="SemiBold" Margin="0,0,0,18"/>
  <TextBlock x:Name="FoundLabel" Text="Найденные устройства"/>
  <ComboBox x:Name="Found" SelectionChanged="FoundChanged"/>
  <TextBlock Text="Название"/><TextBox x:Name="NameBox"/>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions>
   <StackPanel><TextBlock Text="MAC-адрес"/><TextBox x:Name="MacBox" FontFamily="Consolas"/></StackPanel>
   <StackPanel Grid.Column="2"><TextBlock Text="Модель"/><ComboBox x:Name="ModelBox"><ComboBoxItem Content="SL60IIBi"/><ComboBoxItem Content="P260C Pro"/></ComboBox></StackPanel>
  </Grid>
  <TextBlock Text="Горячая клавиша для вкл / выкл"/><TextBox x:Name="HotkeyBox" ToolTip="Например Ctrl+Alt+1. Пустое поле отключает сочетание."/>
  <TextBlock Text="Файл привязки"/>
  <TextBox x:Name="StateBox" TextWrapping="Wrap" FontSize="12"/>
  <Button Content="Выбрать существующий файл…" Click="Browse" HorizontalAlignment="Left"/>
  <TextBlock Text="Привязки хранятся в AppData\Local\Godox\bindings и находятся по MAC. Выбранный внешний файл будет перенесён туда при сохранении. Если привязки нет, после сохранения нажмите «Подключить»." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,4,0,18"/>
  <TextBlock x:Name="ErrorText" Foreground="{StaticResource Accent}" TextWrapping="Wrap" Margin="0,0,0,12"/>
  <WrapPanel HorizontalAlignment="Right"><Button Content="Отмена" IsCancel="True"/><Button Content="Сохранить" Click="Save" IsDefault="True" Background="{StaticResource Accent}" Foreground="#17212B"/></WrapPanel>
 </StackPanel></ScrollViewer>
</Window>
